# ==========================================
# MINSQ BACKEND - PRODUCTION ENVIRONMENT CONFIG
# ==========================================

# Server Environment
NODE_ENV=production
PORT=3001
TRUST_PROXY=1

# URLs & CORS (Domínio do seu frontend na Vercel)
CORS_ORIGIN=https://seu-frontend.vercel.app
FRONTEND_URL=https://seu-frontend.vercel.app

# Database (Supabase)
SUPABASE_URL=https://sua-url-supabase.supabase.co
SUPABASE_SERVICE_KEY=sua-service-role-key-aqui

# Security & JWT (Gere uma chave segura e aleatória)
JWT_SECRET=sua-chave-secreta-jwt-muito-longa-e-segura

# Google OAuth (Opcional se usar login Google)
GOOGLE_CLIENT_ID=seu-google-client-id
GOOGLE_CLIENT_SECRET=seu-google-client-secret
GOOGLE_CALLBACK_URL=https://minsq-api.onrender.com/api/auth/google/callback

# Cloudflare Turnstile (Captcha)
TURNSTILE_SITE_KEY=seu-site-key-turnstile
TURNSTILE_SECRET_KEY=seu-secret-key-turnstile

# E-mail (Resend)
RESEND_API_KEY=sua-api-key-resend
CRON_SECRET=seu-cron-secret
