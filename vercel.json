{
  "rewrites": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "status.minsq-five.vercel.app"
        }
      ],
      "destination": "/pages/api/status.html"
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "maintenance.minsq-five.vercel.app"
        }
      ],
      "destination": "/pages/api/maintenance.html"
    },
    {
      "source": "/api/:path*",
      "destination": "https://minsq-api.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self'" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
