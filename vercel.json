{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://minsq-web.onrender.com/api/:path*"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "web.mohi.com.br"
        }
      ],
      "destination": "/pages/web/index.html"
    },
    {
      "source": "/web",
      "destination": "/pages/web/index.html"
    },
    {
      "source": "/assets/:path*",
      "has": [
        {
          "type": "host",
          "value": "web.mohi.com.br"
        }
      ],
      "destination": "/pages/web/assets/:path*"
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "web.mohi.com.br"
        }
      ],
      "destination": "/pages/web/index.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "status.mohi.com.br"
        }
      ],
      "destination": "/pages/api/status.html"
    },
    {
      "source": "/status",
      "destination": "/pages/api/status.html"
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "status.mohi.com.br"
        }
      ],
      "destination": "/pages/api/status.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "maintenance.mohi.com.br"
        }
      ],
      "destination": "/pages/api/maintenance.html"
    },
    {
      "source": "/maintenance",
      "destination": "/pages/api/maintenance.html"
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "maintenance.mohi.com.br"
        }
      ],
      "destination": "/pages/api/maintenance.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self' https://mohi.com.br https://*.mohi.com.br" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
